---
const title = 'Markagen';
const description =
  'Markagen is building AI-native systems for marketing research, workflow orchestration, and execution.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <main>
      <div class="eyebrow">Markagen</div>
      <h1>AI-native marketing systems.</h1>
      <p>{description}</p>
      <section class="panel">
        <div class="list">
          <div><strong>Status:</strong> early build mode</div>
          <div><strong>Focus:</strong> research workflows, operational handoffs, and agent-assisted execution</div>
          <div><strong>Contact:</strong> op@markagen.ai</div>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :global(:root) { color-scheme: dark; --bg: #0f1117; --surface: #171b24; --text: #f5f7fb; --muted: #a8b1c3; --accent: #67e8f9; --border: #2a3140; }
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; min-height: 100vh; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: radial-gradient(circle at top, #1b2433 0%, var(--bg) 55%); color: var(--text); }
  main { width: min(760px, calc(100vw - 32px)); margin: 0 auto; min-height: 100vh; display: grid; align-content: center; gap: 20px; padding: 40px 0; }
  .eyebrow { color: var(--accent); font-size: 13px; font-weight: 600; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(44px, 8vw, 72px); line-height: 0.98; }
  p { margin: 0; color: var(--muted); font-size: 18px; line-height: 1.6; max-width: 62ch; }
  .panel { border: 1px solid var(--border); background: rgba(23, 27, 36, 0.78); border-radius: 8px; padding: 18px 20px; }
  .list { display: grid; gap: 10px; color: var(--muted); font-size: 15px; }
  strong { color: var(--text); }
</style>
